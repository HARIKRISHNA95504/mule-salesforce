output application/java
---
"SELECT Id, Name, Emp_role__c, Emp_email__c, Emp_phone__c, Emp_skills__c, Emp_city__c " ++
"FROM Employee__c " ++
"WHERE Id = '" ++ attributes.uriParams.id ++ "'"]]></ee:set-payload>
